{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/capture-turn.js",
        "timeout": 20
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/capture-turn.js",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/capture-turn.js",
        "timeout": 20
      }
    ]
  }
}
