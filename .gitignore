# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files. .env.example stays tracked.
# .agent-logs/ is part of the submission and is not ignored.
.env
.env*.local

# Unprocessed catalogue dumps.
/data/raw/

# Playwright output.
/test-results/
/playwright-report/
/blob-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by `prisma generate`.
/lib/generated

# Local hook bookkeeping. The session logs in .agent-logs/ are part of the submission.
.cursor/hooks/.state/
